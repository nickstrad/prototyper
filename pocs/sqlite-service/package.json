{
  "name": "sqlite-service-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:coi": "COI=1 vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "node scripts/serve.mjs dist 4173",
    "serve:coi": "node scripts/serve.mjs dist 4174 --coi",
    "probe:browser": "node scripts/browser-probe.mjs http://127.0.0.1:4173/ http://127.0.0.1:4174/ evidence/browser-probe.json && node scripts/summarize-probe.mjs > evidence/browser-probe-summary.txt"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
