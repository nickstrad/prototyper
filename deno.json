{
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run main.ts",
    "dev": "deno run -A npm:vite@8.3.3 --host 127.0.0.1 --port 5173 --strictPort",
    "build": "deno task assets:duckdb && deno run -A npm:vite@8.3.3 build",
    "serve:static": "deno run -A jsr:@std/http@1.0.19/file-server dist --host 127.0.0.1 --port 4173",
    "check": "deno fmt --check && deno lint && deno check",
    "test": "deno test --allow-read --allow-write=/tmp --allow-env=PROTOTYPER_REPLAY_PATH",
    "test:browser": "deno task assets:duckdb && deno run -A npm:@playwright/test@1.62.0 test",
    "test:browser:npx": "npx playwright test",
    "test:static": "deno task build && PW_TARGET=static deno run -A npm:@playwright/test@1.62.0 test",
    "assets:duckdb": "deno run -A scripts/fetch-duckdb-extensions.ts"
  },
  "imports": {
    "effect": "npm:effect@4.0.2",
    "effect/": "npm:/effect@4.0.2/",
    "just-bash": "npm:just-bash@3.6.0",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0",
    "@xterm/xterm/": "npm:/@xterm/xterm@6.0.0/",
    "react": "npm:react@19.3.0",
    "react/": "npm:/react@19.3.0/",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/": "npm:/react-dom@19.3.0/",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "vite": "npm:vite@8.3.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.2",
    "fast-check": "npm:fast-check@4.10.2",
    "@playwright/test": "npm:@playwright/test@1.62.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/http": "jsr:@std/http@1.0.19",
    "@sqlite.org/sqlite-wasm": "npm:@sqlite.org/sqlite-wasm@3.53.4-build2",
    "@duckdb/duckdb-wasm": "npm:@duckdb/duckdb-wasm@1.32.0",
    "@duckdb/duckdb-wasm-shell": "npm:@duckdb/duckdb-wasm-shell@1.32.0",
    "@types/node": "npm:@types/node@22.20.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "test-results",
    "playwright-report",
    "pocs",
    "public/vendor",
    "dist-*",
    "test-results-*"
  ]
}
